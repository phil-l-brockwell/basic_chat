<% content_for :title, "##{@room.name} · Basic Chat" %>

<div class="w-full flex gap-6">
  <nav class="w-40 shrink-0" aria-label="Rooms">
    <h2 class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-2">Rooms</h2>
    <ul id="rooms" class="space-y-1">
      <% @rooms.each do |room| %>
        <li>
          <%= link_to "##{room.name}", room, class: "block rounded-md px-2 py-1 text-sm #{room == @room ? "bg-blue-50 text-blue-700 font-medium" : "text-gray-700 hover:bg-gray-100"}", aria: { current: ("page" if room == @room) } %>
        </li>
      <% end %>
    </ul>
  </nav>

  <div class="flex-1 min-w-0">
    <h1 class="font-bold text-2xl mb-4">#<%= @room.name %></h1>
    <%= turbo_stream_from @room %>

    <div id="messages_scroller" class="h-[60vh] overflow-y-auto rounded-lg border border-gray-200 bg-white p-4" data-controller="scroll-to-bottom">
      <%= render "messages/older_messages", room: @room, pagy: @pagy %>

      <div id="messages" class="flex flex-col gap-3">
        <%= render @messages.reverse %>
      </div>
    </div>

    <%= render "messages/form", room: @room, message: @message %>
  </div>
</div>
